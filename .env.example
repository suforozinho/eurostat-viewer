# All optional.

# Absolute site URL for canonical and hreflang links. On Vercel,
# VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Shows a "Source code on GitHub" link in the footer.
NEXT_PUBLIC_REPO_URL=

# 1 = answer from fixtures/ instead of calling Eurostat (used by the e2e tests).
EUROSTAT_FIXTURES=
